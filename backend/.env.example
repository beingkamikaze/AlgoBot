# Copy to backend/.env. Never commit .env, never paste these into a chat.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Later phases
OPENAI_API_KEY=
# App
MODE=paper
PAPER_STARTING_CAPITAL=1000000
CORS_ORIGINS=http://localhost:3100
# LLM — Azure OpenAI (LLM_PROVIDER=azure) or OpenAI (LLM_PROVIDER=openai with OPENAI_API_KEY)
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2025-01-01-preview
LLM_DAILY_TOKEN_CAP=400000
# TradingView webhooks: only TradingView's four addresses are accepted (false only for local tests)
WEBHOOK_REQUIRE_TRADINGVIEW_IP=true

# Live trading through Zerodha Kite (Phase 8). OFF unless LIVE_TRADING_ENABLED=true AND you arm it in the app
# each day with two-factor AND you logged in to Kite today. Kite orders also need your app's static IP whitelisted.
LIVE_TRADING_ENABLED=false
KITE_API_KEY=
KITE_API_SECRET=
KITE_ALGO_ID=
# encrypts the daily Kite token; make one with:
#   backend/.venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# where Kite's login sends you back to (the web app)
WEB_URL=http://localhost:3100

# On a server: every /api route needs a signed-in user, and only these emails may use the app
REQUIRE_AUTH=false
ALLOWED_EMAILS=

# Global setup (XAUUSD). Live spot prices need a free key from twelvedata.com; without it the chart uses GC=F futures.
TWELVEDATA_API_KEY=
# Slow background download of Dukascopy spot history, while the app runs
GLOBAL_BACKFILL_ENABLED=true
GLOBAL_BACKFILL_START=2021-01-01
GLOBAL_AGENT_ENABLED=true
GLOBAL_AGENT_LOOKS_PER_DAY=16
GLOBAL_AGENT_COOLDOWN_MINUTES=15

# Telegram approval (optional): make a bot with @BotFather, paste its token, restart, then press Connect Telegram on the
# XAUUSD agent page. Ideas and paper tickets arrive with buttons; nothing trades without your taps.
TELEGRAM_BOT_TOKEN=

# MT5 demo (optional): the Windows bridge next to the MT5 terminal. Use a long random token, the same as BRIDGE_TOKEN there.
# Demo accounts only: the app refuses a real account.
MT5_BRIDGE_URL=
MT5_BRIDGE_TOKEN=
